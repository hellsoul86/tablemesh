# Local development only. Keep credentials out of source control.
TABLEMESH_HOST=127.0.0.1
TABLEMESH_PORT=4100
TABLEMESH_DB=./data/tablemesh.sqlite
TABLEMESH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
# Optional trusted HTTP MCP address. Leave empty for the actual loopback listener.
# Remote addresses require HTTPS and the exact /mcp path; this does not deploy a service.
TABLEMESH_MCP_PUBLIC_URL=
TABLEMESH_STARTER_POINTS=1000
TABLEMESH_REAL_REWARDS=false
# Generate a random 32-byte base64 key locally. Never put it in VITE_ variables.
# When missing, inventory import and secret retrieval are disabled.
TABLEMESH_INVENTORY_KEY=
# Separate admin bearer, supplied locally; normal accounts never receive it.
TABLEMESH_ADMIN_TOKEN=
# Local stdio adapter only; mint a game token in the account page.
TABLEMESH_URL=http://127.0.0.1:4100
TABLEMESH_TOKEN=
